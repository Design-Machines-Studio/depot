[Unit]
Description=Design Machines Workflow Authority socket
Before=workflow-authority.service

[Socket]
ListenStream=/run/design-machines/workflow-authority/authority.sock
SocketUser=root
SocketGroup=workflow-authority
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Service=workflow-authority.service

[Install]
WantedBy=sockets.target
