{
  "schemaVersion": 4,
  "comment": "Pipeline owns workflow depth and role intent. model-router alone owns candidates, providers, transports, billing, availability, and fallback.",
  "chunkKinds": {
    "docs": {"executorRole": "builder-fast", "executorCapabilities": ["read-repository", "write-repository", "structured-output"], "executorEffort": "low"},
    "config": {"executorRole": "builder-fast", "executorCapabilities": ["read-repository", "write-repository", "structured-output"], "executorEffort": "medium"},
    "mechanical-logic": {"executorRole": "builder-fast", "executorCapabilities": ["read-repository", "write-repository", "structured-output"], "executorEffort": "medium"},
    "logic": {"executorRole": "builder-deep", "executorCapabilities": ["read-repository", "write-repository", "structured-output"], "executorEffort": "high"},
    "ui": {"executorRole": "builder-deep", "executorCapabilities": ["read-repository", "write-repository", "structured-output"], "executorEffort": "high"},
    "integration": {"executorRole": "builder-deep", "executorCapabilities": ["read-repository", "write-repository", "structured-output"], "executorEffort": "high"}
  },
  "legacyExecutorTranslation": {
    "openrouter": {"executorRole": "builder-fast", "executorCapabilities": ["read-repository", "write-repository", "structured-output"], "executorEffort": "medium"},
    "codex": {"executorRole": "builder-deep", "executorCapabilities": ["read-repository", "write-repository", "long-context", "structured-output"], "executorEffort": "high"},
    "claude": {"executorRole": "builder-deep", "executorCapabilities": ["read-repository", "write-repository", "long-context", "structured-output"], "executorEffort": "high"}
  },
  "routingOverride": {
    "allowedKeys": ["executorRole", "executorCapabilities", "executorEffort", "reasonCode", "reason"],
    "reasonCodes": ["sensitive-path", "required-live-tool", "complexity-escalation", "bounded-mechanical-work", "bounded-settled-work"],
    "forbiddenKeys": ["executor", "model", "provider", "transport", "billingMode", "family"]
  },
  "reviewRoles": {
    "security": {"role": "security-review", "capabilities": ["read-repository", "long-context", "structured-output"], "effort": "high"},
    "architecture": {"role": "review-deep", "capabilities": ["read-repository", "long-context", "structured-output"], "effort": "high"},
    "pattern": {"role": "review-deep", "capabilities": ["read-repository", "structured-output"], "effort": "high"},
    "simplicity": {"role": "review-deep", "capabilities": ["read-repository", "structured-output"], "effort": "high"},
    "documentation": {"role": "review-fast", "capabilities": ["read-repository", "structured-output"], "effort": "medium"},
    "tests": {"role": "review-fast", "capabilities": ["read-repository", "tool-use", "structured-output"], "effort": "medium"},
    "secondPerspective": {"role": "plan-critic", "capabilities": ["read-repository", "long-context", "structured-output"], "effort": "high"}
  },
  "decisionLeverage": {
    "scope": "workflow-depth-only",
    "allowedLevels": ["low", "medium", "high"],
    "legacyDefault": {"planningDepth": "current-standard-path", "verificationDepth": "current-standard-path", "receiptFlag": "decision_profile_defaulted=true", "semanticClaim": "unknown-not-low-low"},
    "rules": {
      "lowLow": {"when": {"uncertainty": "low", "consequence": "low"}, "planningDepth": "acceptance-or-short-plan", "verificationDepth": "focused-required"},
      "highUncertainty": {"when": {"uncertainty": "high"}, "planningDepth": "one-independent-opinion-plus-bounded-synthesis", "verificationDepth": "standard-unless-high-consequence"},
      "highConsequence": {"when": {"consequence": "high"}, "planningDepth": "standard-unless-high-uncertainty", "verificationDepth": "stronger-existing-independent-seam"}
    },
    "neverControls": ["role", "capabilities", "effort", "model", "provider", "transport", "billing", "security-policy", "authorization", "rendered-surface", "review-roster", "finding-severity"]
  },
  "workflowSelection": {
    "assessmentInputs": [
      "acceptanceClear",
      "designSettled",
      "consequence",
      "reversibility",
      "coordination",
      "existingPattern",
      "verificationDefined",
      "unansweredQuestions"
    ],
    "paths": {
      "direct": {
        "stages": [
          "implement",
          "verify",
          "deliver"
        ]
      },
      "lean": {
        "stages": [
          "targeted-research",
          "short-plan",
          "implement",
          "verify",
          "independent-review",
          "deliver"
        ]
      },
      "full": {
        "stages": [
          "assess",
          "targeted-research",
          "plan",
          "applicable-adversary",
          "execute",
          "verify",
          "independent-review",
          "deliver"
        ]
      }
    },
    "selection": "Use select-workflow.sh with source-backed facts; file count, language, UI and integration labels never determine depth. Explicit full and repository requirements win; escalate incrementally without discarding valid work."
  }
}
