{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/review/references/review-completion-hook.sh\" session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/review/references/review-completion-hook.sh\" stop",
            "statusMessage": "Checking review readiness..."
          }
        ]
      }
    ]
  }
}
