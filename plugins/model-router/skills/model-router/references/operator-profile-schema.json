{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.studio/schemas/model-router-local-profile-v1.json",
  "title": "Developer-local model router preferences",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allowPaidClaudeCredits": {"type": "boolean", "default": false},
    "disabledCandidates": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"},
      "default": []
    }
  }
}
