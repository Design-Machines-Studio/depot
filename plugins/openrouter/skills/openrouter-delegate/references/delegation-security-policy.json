{
  "schemaVersion": 2,
  "disclosureControls": {
    "refuseClasses": [
      "high-confidence credentials",
      "private keys",
      "authenticated connection strings / DSNs",
      "access or session tokens",
      "explicitly classified private or regulated values"
    ],
    "placeholderValues": [
      "<token>",
      "<redacted>",
      "REDACTED",
      "example",
      "changeme",
      "${VARIABLE}",
      "$VARIABLE",
      "..."
    ],
    "onMatch": "decline-disclosure",
    "exitCode": 3,
    "rationale": "Classify the exact outbound bytes. Names of files, directories, headers, variables, vendors, nationalities, and jurisdictions are not disclosure evidence."
  },
  "executionControls": {
    "requirements": [
      "non-empty validated unified diff",
      "normalized relative paths",
      "exact complete owned-path allowlist",
      "no symlink escape",
      "trusted caller-supplied verification",
      "allowlist-only staging"
    ],
    "modelCommandAuthority": "none",
    "malformedInput": "fail-closed"
  },
  "delegationModes": {
    "execution": {
      "contentValidation": "exact-outbound-prompt-and-complete-diff",
      "outputAuthority": "validated-unified-diff-within-owned-paths"
    },
    "mechanical-review": {
      "contentValidation": "complete-diff-partitioned-by-file-section-including-removed-lines",
      "sensitiveSectionAction": "exclude-section-and-require-codex-coverage",
      "emptyRemainder": "decline-disclosure",
      "outputAuthority": "review-text-only"
    },
    "artifact-review": {
      "contentValidation": "exact-artifact-content",
      "pathReferences": "allow",
      "outputAuthority": "review-text-only"
    },
    "artifact-delegation": {
      "contentValidation": "multiple-explicit-text-files-exact-bytes",
      "pathReferences": "allow",
      "outputAuthority": "none",
      "executionPathAuthority": "none"
    }
  },
  "reviewControls": {
    "highConsequenceSecuritySignoff": "independent-non-implementing-family-required",
    "modelNationalityEmbargo": false,
    "vendorJurisdictionEmbargo": false,
    "pathNameEmbargo": false,
    "rationale": "Security-related implementation may be delegated after content and output validation; consequential security completion requires a reviewer family different from the implementer."
  },
  "positiveRouting": {
    "intendedLanes": [
      "security analysis with independent non-implementing-family sign-off",
      "style / formatting",
      "duplication",
      "pattern-recognition",
      "large-diff first-pass triage",
      "doc consistency"
    ],
    "rationale": "These are the OpenRouter mechanical lanes when exact outbound content passes disclosure controls."
  }
}
