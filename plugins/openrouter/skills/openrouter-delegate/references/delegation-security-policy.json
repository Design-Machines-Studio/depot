{
  "schemaVersion": 2,
  "disclosureControls": {
    "providerInputParity": true,
    "refuseClasses": [],
    "placeholderValues": [
      "<token>",
      "<redacted>",
      "REDACTED",
      "example",
      "changeme",
      "${VARIABLE}",
      "$VARIABLE",
      "..."
    ],
    "onMatch": "allow-provider-parity",
    "exitCode": 0,
    "rationale": "OpenRouter receives the same authorized task and repository evidence as native subscription transports. This boundary validates structure and authority, not content classes."
  },
  "executionControls": {
    "requirements": [
      "non-empty validated unified diff",
      "normalized relative paths",
      "exact complete owned-path allowlist",
      "no symlink escape",
      "trusted caller-supplied verification",
      "allowlist-only staging"
    ],
    "modelCommandAuthority": "none",
    "malformedInput": "fail-closed"
  },
  "delegationModes": {
    "execution": {
      "contentValidation": "exact-outbound-prompt-and-complete-diff",
      "outputAuthority": "validated-unified-diff-within-owned-paths"
    },
    "mechanical-review": {
      "contentValidation": "complete-structurally-valid-diff-including-removed-lines",
      "sensitiveSectionAction": "include-under-provider-input-parity",
      "emptyRemainder": "input-invalid",
      "outputAuthority": "review-text-only"
    },
    "artifact-review": {
      "contentValidation": "exact-artifact-content",
      "pathReferences": "allow",
      "outputAuthority": "review-text-only"
    },
    "artifact-delegation": {
      "contentValidation": "multiple-explicit-text-files-exact-bytes",
      "pathReferences": "allow",
      "outputAuthority": "none",
      "executionPathAuthority": "none"
    }
  },
  "reviewControls": {
    "highConsequenceSecuritySignoff": "independent-non-implementing-family-required",
    "modelNationalityEmbargo": false,
    "vendorJurisdictionEmbargo": false,
    "pathNameEmbargo": false,
    "rationale": "Security-related implementation uses the same input eligibility as native transports; consequential security completion still requires a reviewer family different from the implementer."
  },
  "positiveRouting": {
    "intendedLanes": [
      "security analysis with independent non-implementing-family sign-off",
      "style / formatting",
      "duplication",
      "pattern-recognition",
      "large-diff first-pass triage",
      "doc consistency"
    ],
    "rationale": "These are OpenRouter lanes under the same input-eligibility contract as native subscription transports."
  }
}
