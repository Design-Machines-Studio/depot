{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.dev/schemas/workflow-kernel/provider-dispatch-allocation-v1.json",
  "title": "Daemon-first provider dispatch allocation frames v1",
  "oneOf": [
    {"$ref": "#/$defs/authority_hello"},
    {"$ref": "#/$defs/dispatch_proposal"},
    {"$ref": "#/$defs/consent_ack"},
    {"$ref": "#/$defs/safe_error"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "part": {"type": "object", "additionalProperties": false, "required": ["role", "content_length", "content_sha256"], "properties": {"role": {"enum": ["system", "user"]}, "content_length": {"type": "integer", "minimum": 0, "maximum": 1048576}, "content_sha256": {"$ref": "#/$defs/digest"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["repository", "run_id", "lane", "candidate", "workload"], "properties": {"repository": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "lane": {"$ref": "#/$defs/id"}, "candidate": {"$ref": "#/$defs/id"}, "workload": {"$ref": "#/$defs/id"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_request_bytes", "max_response_bytes", "max_parts", "max_active_allocations", "allocation_ttl_seconds", "cancellation"], "properties": {"max_request_bytes": {"const": 8388608}, "max_response_bytes": {"const": 8388608}, "max_parts": {"const": 256}, "max_active_allocations": {"const": 1}, "allocation_ttl_seconds": {"const": 120}, "cancellation": {"const": "consume_tombstone"}}},
    "authority_hello": {"type": "object", "additionalProperties": false, "required": ["schema_version", "protocol", "type", "daemon_build_sha256", "scanner_build_sha256", "policy_sha256", "boot_id", "session_id", "sequence", "issued_at", "expires_at", "prior_chain_digest", "connection_nonce_sha256", "limits"], "properties": {"schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"}, "type": {"const": "authority_hello"}, "daemon_build_sha256": {"$ref": "#/$defs/digest"}, "scanner_build_sha256": {"$ref": "#/$defs/digest"}, "policy_sha256": {"$ref": "#/$defs/digest"}, "boot_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "issued_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"}, "prior_chain_digest": {"$ref": "#/$defs/digest"}, "connection_nonce_sha256": {"$ref": "#/$defs/digest"}, "limits": {"$ref": "#/$defs/limits"}}},
    "dispatch_proposal": {"type": "object", "additionalProperties": false, "required": ["schema_version", "protocol", "type", "mapping", "operation_family", "substrate_authority", "destination", "method", "path", "models", "parts", "scope", "caller_nonce", "authority_hello_sha256"], "properties": {"schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"}, "type": {"const": "dispatch_proposal"}, "mapping": {"const": "openrouter-chat-v1"}, "operation_family": {"const": "external_provider_dispatch"}, "substrate_authority": {"const": "not_asserted"}, "destination": {"const": "https://openrouter.ai"}, "method": {"const": "POST"}, "path": {"const": "/api/v1/chat/completions"}, "models": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "parts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/part"}}, "scope": {"$ref": "#/$defs/scope"}, "caller_nonce": {"$ref": "#/$defs/id"}, "authority_hello_sha256": {"$ref": "#/$defs/digest"}}},
    "consent_ack": {"type": "object", "additionalProperties": false, "required": ["schema_version", "protocol", "type", "challenge_sha256"], "properties": {"schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"}, "type": {"const": "consent_ack"}, "challenge_sha256": {"$ref": "#/$defs/digest"}}},
    "safe_error": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "protocol", "type", "code", "exit_code", "consumed", "network_attempted"],
      "properties": {"schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"}, "type": {"const": "safe_error"}, "code": {"enum": ["disclosure_declined", "authorization_declined", "authorization_expired", "authorization_replayed", "consent_connection_invalid", "authority_unavailable"]}, "exit_code": {"enum": [70, 71, 72]}, "consumed": {"const": true}, "network_attempted": {"const": false}},
      "oneOf": [
        {"properties": {"code": {"const": "disclosure_declined"}, "exit_code": {"const": 72}, "network_attempted": {"const": false}}},
        {"properties": {"code": {"enum": ["authorization_declined", "authorization_expired", "authorization_replayed", "consent_connection_invalid"]}, "exit_code": {"const": 71}, "network_attempted": {"const": false}}},
        {"properties": {"code": {"const": "authority_unavailable"}, "exit_code": {"const": 70}, "network_attempted": {"const": false}}}
      ]
    }
  }
}
