{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.studio/schemas/repository-verification-receipts-v1.json",
  "title": "Repository Verification Receipt Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_role", "receipts"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_role": {"const": "repository_verification_receipts"},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version", "lane_id", "tier", "boundary", "owner",
          "required", "status", "reason", "command_digest", "input_digest",
          "cache_key", "exit_code", "duration_seconds",
          "source_receipt_digest", "stdout_digest", "stderr_digest",
          "stdout_bytes", "stderr_bytes", "profile_digest", "head_commit",
          "provider_run_id", "observed_at", "evidence_digest", "receipt_auth"
        ],
        "properties": {
          "schema_version": {"const": 1},
          "profile_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "lane_id": {"type": "string"},
          "tier": {
            "enum": [
              "doctor", "fast", "focused", "full", "race", "harness", "remote"
            ]
          },
          "boundary": {
            "enum": [
              "chunk", "revision_batch", "execution_level",
              "merge_candidate", "post_merge"
            ]
          },
          "owner": {
            "enum": ["local", "github", "blueprint", "other", "unresolved"]
          },
          "required": {"type": "boolean"},
          "status": {
            "enum": [
              "passed", "failed", "reused", "remote_pending", "blocked",
              "unavailable"
            ]
          },
          "reason": {"type": "string"},
          "command_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "input_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "cache_key": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "exit_code": {"type": ["integer", "null"]},
          "duration_seconds": {"type": "number", "minimum": 0},
          "source_receipt_digest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stdout_digest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stderr_digest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stdout_bytes": {"type": "integer", "minimum": 0},
          "stderr_bytes": {"type": "integer", "minimum": 0},
          "head_commit": {
            "type": ["string", "null"],
            "pattern": "^(?:unresolved|[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "provider_run_id": {"type": ["string", "null"]},
          "observed_at": {"type": ["string", "null"]},
          "evidence_digest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "receipt_auth": {
            "type": "string",
            "pattern": "^hmac-sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
