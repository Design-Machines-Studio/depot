{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.dev/schemas/workflow-kernel/provider-dispatch-exchange-v1.json",
  "title": "Provider dispatch single-connection exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "state", "request", "request_body_sha256", "challenge", "consent_ack", "result", "safe_error", "consumed", "network_attempted", "response_retrievable"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol": {"const": "workflow-authority-provider-dispatch-v1"},
    "state": {"enum": ["reserved", "challenged", "authorized", "sent", "terminal", "tombstone"]},
    "request": {"$ref": "https://designmachines.dev/schemas/workflow-kernel/provider-dispatch-request-v1.json"},
    "request_body_sha256": {"$ref": "#/$defs/digest"},
    "challenge": {"oneOf": [{"$ref": "#/$defs/challenge"}, {"type": "null"}]},
    "consent_ack": {"oneOf": [{"$ref": "#/$defs/consent_ack"}, {"type": "null"}]},
    "result": {"oneOf": [{"$ref": "https://designmachines.dev/schemas/workflow-kernel/provider-dispatch-result-v1.json"}, {"type": "null"}]},
    "safe_error": {"oneOf": [{"$ref": "#/$defs/safe_error"}, {"type": "null"}]},
    "consumed": {"type": "boolean"},
    "network_attempted": {"type": "boolean"},
    "response_retrievable": {"const": false}
  },
  "oneOf": [
    {"properties": {"state": {"const": "reserved"}, "challenge": {"type": "null"}, "consent_ack": {"type": "null"}, "result": {"type": "null"}, "safe_error": {"type": "null"}, "consumed": {"const": false}, "network_attempted": {"const": false}}},
    {"properties": {"state": {"const": "challenged"}, "challenge": {"$ref": "#/$defs/challenge"}, "consent_ack": {"type": "null"}, "result": {"type": "null"}, "safe_error": {"type": "null"}, "consumed": {"const": false}, "network_attempted": {"const": false}}},
    {"properties": {"state": {"const": "authorized"}, "challenge": {"$ref": "#/$defs/challenge"}, "consent_ack": {"$ref": "#/$defs/consent_ack"}, "result": {"type": "null"}, "safe_error": {"type": "null"}, "consumed": {"const": false}, "network_attempted": {"const": false}}},
    {"properties": {"state": {"const": "sent"}, "challenge": {"$ref": "#/$defs/challenge"}, "consent_ack": {"$ref": "#/$defs/consent_ack"}, "result": {"type": "null"}, "safe_error": {"type": "null"}, "consumed": {"const": false}, "network_attempted": {"const": true}}},
    {"properties": {"state": {"const": "terminal"}, "challenge": {"$ref": "#/$defs/challenge"}, "consent_ack": {"$ref": "#/$defs/consent_ack"}, "result": {"$ref": "https://designmachines.dev/schemas/workflow-kernel/provider-dispatch-result-v1.json"}, "safe_error": {"type": "null"}, "consumed": {"const": true}, "network_attempted": {"const": true}}},
    {"properties": {"state": {"const": "tombstone"}, "result": {"type": "null"}, "safe_error": {"$ref": "#/$defs/safe_error"}, "consumed": {"const": true}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["repository", "run_id", "lane", "candidate", "workload"], "properties": {"repository": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "lane": {"$ref": "#/$defs/id"}, "candidate": {"$ref": "#/$defs/id"}, "workload": {"$ref": "#/$defs/id"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_request_bytes", "max_response_bytes", "max_parts", "max_pending_per_peer", "max_pending_per_repository", "max_pending_per_daemon"], "properties": {"max_request_bytes": {"const": 8388608}, "max_response_bytes": {"const": 8388608}, "max_parts": {"const": 256}, "max_pending_per_peer": {"const": 4}, "max_pending_per_repository": {"const": 16}, "max_pending_per_daemon": {"const": 64}}},
    "challenge": {"type": "object", "additionalProperties": false, "required": ["schema_version", "protocol", "mapping", "operation_family", "substrate_authority", "transaction_id", "connection_nonce_sha256", "peer_uid", "peer_pid", "request_body_sha256", "destination", "method", "path", "models", "scope", "daemon_build_sha256", "scanner_build_sha256", "policy_sha256", "nonce", "sequence", "boot_id", "session_id", "issued_at", "expires_at", "limits", "result_signer", "authority_assertion", "prior_chain_digest"], "properties": {"schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"}, "mapping": {"const": "openrouter-chat-v1"}, "operation_family": {"const": "external_provider_dispatch"}, "substrate_authority": {"const": "not_asserted"}, "transaction_id": {"$ref": "#/$defs/id"}, "connection_nonce_sha256": {"$ref": "#/$defs/digest"}, "peer_uid": {"type": "integer", "minimum": 0}, "peer_pid": {"type": "integer", "minimum": 1}, "request_body_sha256": {"$ref": "#/$defs/digest"}, "destination": {"const": "https://openrouter.ai"}, "method": {"const": "POST"}, "path": {"const": "/api/v1/chat/completions"}, "models": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "scope": {"$ref": "#/$defs/scope"}, "daemon_build_sha256": {"$ref": "#/$defs/digest"}, "scanner_build_sha256": {"$ref": "#/$defs/digest"}, "policy_sha256": {"$ref": "#/$defs/digest"}, "nonce": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1}, "boot_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}, "issued_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"}, "limits": {"$ref": "#/$defs/limits"}, "result_signer": {"oneOf": [{"$ref": "#/$defs/es256_signer"}, {"$ref": "#/$defs/fixture_signer"}]}, "authority_assertion": {"oneOf": [{"$ref": "#/$defs/fido_assertion"}, {"$ref": "#/$defs/fixture_assertion"}]}, "prior_chain_digest": {"$ref": "#/$defs/digest"}}},
    "consent_ack": {"type": "object", "additionalProperties": false, "required": ["schema_version", "protocol", "type", "challenge_sha256"], "properties": {"schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"}, "type": {"const": "consent_ack"}, "challenge_sha256": {"$ref": "#/$defs/digest"}}},
    "safe_error": {"enum": ["frame_too_large", "part_frame_mismatch", "exchange_state_invalid", "content_order_invalid", "terminal_binding_invalid", "consent_connection_invalid", "exchange_trailing_data", "invalid_document", "noncanonical_document", "bounds_exceeded", "authorization_declined", "authorization_expired", "authorization_replayed", "disclosure_declined", "authority_unavailable", "provider_failure", "provider_result_unknown", "result_verification_failed", "rate_limited"]},
    "fido_assertion": {"type": "object", "additionalProperties": false, "required": ["kind", "credential_id", "authenticator_data", "client_data_json", "signature_der", "user_presence", "user_verification"], "properties": {"kind": {"const": "fido2-es256"}, "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,4096}$"}, "authenticator_data": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,4096}$"}, "client_data_json": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,4096}$"}, "signature_der": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,4096}$"}, "user_presence": {"const": true}, "user_verification": {"const": true}}},
    "fixture_assertion": {"type": "object", "additionalProperties": false, "required": ["kind", "domain", "value"], "properties": {"kind": {"const": "fixture-rsa-sha256-v1"}, "domain": {"const": "fixture.workflow-authority.invalid"}, "value": {"type": "string", "pattern": "^fixture-rsa-sha256-v1:[0-9a-f]{256}$"}}},
    "es256_signer": {"type": "object", "additionalProperties": false, "required": ["kind", "public_key_sec1"], "properties": {"kind": {"const": "ephemeral-es256"}, "public_key_sec1": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,4096}$"}}},
    "fixture_signer": {"type": "object", "additionalProperties": false, "required": ["kind", "domain", "public_key"], "properties": {"kind": {"const": "fixture-rsa-sha256-v1"}, "domain": {"const": "fixture.workflow-authority.invalid"}, "public_key": {"type": "string", "pattern": "^fixture-rsa-sha256-v1:[0-9a-f]{256}:10001$"}}}
  }
}
