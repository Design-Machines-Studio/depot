{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://designmachines.studio/schemas/repository-verification-provider-attestation.json",
    "title": "Repository Verification Provider Attestation",
    "oneOf": [
        {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "artifact_role",
                "provider",
                "provider_run_id",
                "head_commit",
                "evidence_digest",
                "observed_at",
                "outcome",
                "exit_code",
                "attestation_auth"
            ],
            "properties": {
                "schema_version": {
                    "const": 1
                },
                "artifact_role": {
                    "const": "repository_verification_provider_attestation"
                },
                "provider": {
                    "enum": [
                        "github",
                        "blueprint",
                        "other"
                    ]
                },
                "provider_run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                },
                "head_commit": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "evidence_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "observed_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "outcome": {
                    "enum": [
                        "passed",
                        "failed"
                    ]
                },
                "exit_code": {
                    "type": "integer"
                },
                "attestation_auth": {
                    "type": "string",
                    "pattern": "^hmac-sha256:[0-9a-f]{64}$"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "artifact_role",
                "authority_mode",
                "provider",
                "provider_run_id",
                "head_commit",
                "evidence_ref",
                "evidence_digest",
                "observed_at",
                "outcome",
                "exit_code",
                "verifier_provenance",
                "authority_provenance"
            ],
            "properties": {
                "schema_version": {
                    "const": 2
                },
                "artifact_role": {
                    "const": "repository_verification_provider_attestation"
                },
                "authority_mode": {
                    "const": "native_provider"
                },
                "provider": {
                    "enum": [
                        "github",
                        "blueprint",
                        "other"
                    ]
                },
                "provider_run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                },
                "head_commit": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "evidence_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                },
                "evidence_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "maxLength": 64
                },
                "outcome": {
                    "enum": [
                        "passed",
                        "failed"
                    ]
                },
                "exit_code": {
                    "type": "integer"
                },
                "verifier_provenance": {
                    "$ref": "authority-provider-schema.json#/$defs/evidenceDecision"
                },
                "authority_provenance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "authority_mode",
                        "grant",
                        "envelope",
                        "key_record"
                    ],
                    "properties": {
                        "authority_mode": {
                            "const": "native_provider"
                        },
                        "grant": {
                            "$ref": "authority-provider-schema.json#/$defs/grant"
                        },
                        "envelope": {
                            "$ref": "authority-provider-schema.json#/$defs/envelope"
                        },
                        "key_record": {
                            "$ref": "authority-provider-schema.json#/$defs/keyRecord"
                        }
                    }
                }
            }
        }
    ]
}
