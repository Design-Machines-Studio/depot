{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.studio/schemas/repository-verification-provider-attestation-v1.json",
  "title": "Repository Verification Provider Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_role", "provider", "provider_run_id",
    "head_commit", "evidence_digest", "observed_at", "outcome", "exit_code",
    "attestation_auth"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_role": {
      "const": "repository_verification_provider_attestation"
    },
    "provider": {"enum": ["github", "blueprint", "other"]},
    "provider_run_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "head_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["passed", "failed"]},
    "exit_code": {"type": "integer"},
    "attestation_auth": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    }
  }
}
