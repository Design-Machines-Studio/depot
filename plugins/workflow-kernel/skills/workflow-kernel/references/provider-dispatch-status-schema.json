{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.dev/schemas/workflow-kernel/provider-dispatch-status-v1.json",
  "title": "Production-ineligible provider dispatch fixture status v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "protocol", "production_ready", "fixture_domain", "socket_root_source", "pending", "limits", "last_error_code"],
  "properties": {
    "schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"}, "production_ready": {"const": false},
    "fixture_domain": {"const": "fixture.workflow-authority.invalid"}, "socket_root_source": {"const": "injected-test-only"}, "pending": {"type": "integer", "minimum": 0, "maximum": 64},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_request_bytes", "max_response_bytes", "max_parts", "max_pending_per_peer", "max_pending_per_repository", "max_pending_per_daemon"], "properties": {"max_request_bytes": {"const": 8388608}, "max_response_bytes": {"const": 8388608}, "max_parts": {"const": 256}, "max_pending_per_peer": {"const": 4}, "max_pending_per_repository": {"const": 16}, "max_pending_per_daemon": {"const": 64}}},
    "last_error_code": {"type": ["string", "null"], "enum": [null, "frame_too_large", "part_frame_mismatch", "exchange_state_invalid", "content_order_invalid", "terminal_binding_invalid", "consent_connection_invalid", "exchange_trailing_data", "invalid_document", "noncanonical_document", "bounds_exceeded", "authorization_declined", "authorization_expired", "authorization_replayed", "disclosure_declined", "authority_unavailable", "provider_failure", "provider_result_unknown", "result_verification_failed", "rate_limited"]}
  }
}
