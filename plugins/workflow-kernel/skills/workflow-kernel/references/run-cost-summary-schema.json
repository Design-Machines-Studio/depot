{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.ca/schemas/workflow-kernel/run-cost-summary-v1.json",
  "title": "Workflow kernel run cost summary",
  "description": "Canonical, deterministic per-run cost artifact emitted alongside authoritative receipts. Observation only \u2014 never gates, waives, selects, or alters any lane, phase, or review outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_identity",
    "versions",
    "invocation",
    "phases",
    "lanes",
    "totals",
    "measurement_coverage",
    "volatile_fields",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "workflow_class",
        "repository_commit",
        "dirty_state"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workflow_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty_state": {
          "type": "boolean"
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_version"
      ],
      "properties": {
        "kernel_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "plugin_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emitted_at",
        "first_event_at",
        "last_event_at"
      ],
      "properties": {
        "emitted_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "first_event_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_event_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "phases": {
      "type": "array",
