          },
          "input_usage_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "output_usage_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cache_read_usage_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cache_write_usage_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reasoning_usage_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "measurement_source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "usage_estimated": {
            "type": "boolean"
          },
          "input_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Deterministic input BYTES for lanes with no provider usage receipt. Never a token count and never comparable to input_usage_count.",
            "minimum": 0
          }
        }
      }
    },
    "lanes": {
      "type": "array",
