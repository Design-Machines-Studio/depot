          },
          "reasoning_usage_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "measurement_source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "usage_estimated": {
            "type": "boolean"
          },
          "input_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Deterministic input BYTES for lanes with no provider usage receipt. Never a token count and never comparable to input_usage_count.",
            "minimum": 0
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_count",
        "input_usage_count",
        "output_usage_count",
