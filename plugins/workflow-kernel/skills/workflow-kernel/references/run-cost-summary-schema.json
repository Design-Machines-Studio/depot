        "cost"
      ],
      "properties": {
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "measured",
            "estimated",
            "missing",
            "overlap",
            "unassigned"
          ],
          "properties": {
            "expected": {
              "type": "integer"
            },
            "measured": {
