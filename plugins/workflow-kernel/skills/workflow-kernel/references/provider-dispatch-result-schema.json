{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designmachines.dev/schemas/workflow-kernel/provider-dispatch-result-v1.json",
  "title": "Content-free signed provider dispatch result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "operation_family", "substrate_authority", "outcome", "exit_code", "request_body_sha256", "response_sha256", "response_length", "part_count", "models", "selected_model", "provider", "scope", "sequence", "issued_at", "completed_at", "challenge_sha256", "authority_assertion_sha256", "result_signer_sha256", "prior_chain_digest", "cleanup", "signature"],
  "properties": {
    "schema_version": {"const": 1}, "protocol": {"const": "workflow-authority-provider-dispatch-v1"},
    "operation_family": {"const": "external_provider_dispatch"}, "substrate_authority": {"const": "not_asserted"},
    "outcome": {"enum": ["verified", "provider_failure", "unknown"]}, "exit_code": {"enum": [0, 2, 70, 71, 72, 73, 74, 75]},
    "request_body_sha256": {"$ref": "#/$defs/digest"}, "response_sha256": {"$ref": "#/$defs/digest"},
    "response_length": {"type": "integer", "minimum": 0, "maximum": 8388608}, "part_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "models": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/id"}}, "selected_model": {"$ref": "#/$defs/id"}, "provider": {"const": "openrouter"},
    "scope": {"$ref": "#/$defs/scope"}, "sequence": {"type": "integer", "minimum": 1}, "issued_at": {"$ref": "#/$defs/time"}, "completed_at": {"$ref": "#/$defs/time"},
    "challenge_sha256": {"$ref": "#/$defs/digest"}, "authority_assertion_sha256": {"$ref": "#/$defs/digest"}, "result_signer_sha256": {"$ref": "#/$defs/digest"}, "prior_chain_digest": {"$ref": "#/$defs/digest"},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["reservation", "connection", "content_buffer"], "properties": {"reservation": {"const": "consumed"}, "connection": {"const": "closed"}, "content_buffer": {"const": "discarded"}}},
    "signature": {"oneOf": [{"$ref": "#/$defs/es256_signature"}, {"$ref": "#/$defs/fixture_signature"}]}
  },
  "oneOf": [
    {"properties": {"outcome": {"const": "verified"}, "exit_code": {"const": 0}}},
    {"properties": {"outcome": {"const": "provider_failure"}, "exit_code": {"const": 73}}},
    {"properties": {"outcome": {"const": "unknown"}, "exit_code": {"const": 74}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["repository", "run_id", "lane", "candidate", "workload"], "properties": {"repository": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "lane": {"$ref": "#/$defs/id"}, "candidate": {"$ref": "#/$defs/id"}, "workload": {"$ref": "#/$defs/id"}}},
    "es256_signature": {"type": "object", "additionalProperties": false, "required": ["kind", "signature_der"], "properties": {"kind": {"const": "es256"}, "signature_der": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,4096}$"}}},
    "fixture_signature": {"type": "object", "additionalProperties": false, "required": ["kind", "domain", "value"], "properties": {"kind": {"const": "fixture-rsa-sha256-v1"}, "domain": {"const": "fixture.workflow-authority.invalid"}, "value": {"type": "string", "pattern": "^fixture-rsa-sha256-v1:[0-9a-f]{256}$"}}}
  }
}
