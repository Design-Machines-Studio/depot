{
  "schema_version": 1,
  "profile_id": "assembly-go-docker",
  "lanes": [
    {
      "id": "repository-doctor",
      "tier": "doctor",
      "cadences": [
        "chunk",
        "revision_batch",
        "execution_level",
        "merge_candidate",
        "post_merge"
      ],
      "owner": "local",
      "argv": ["git", "diff", "--check"],
      "input_paths": [".dm/verification.json"],
      "authority_paths": [".dm/verification.json"],
      "cache": "never"
    },
    {
      "id": "templ-generate",
      "tier": "fast",
      "cadences": ["chunk", "revision_batch"],
      "owner": "local",
      "argv": [
        "docker",
        "compose",
        "run",
        "--rm",
        "--no-deps",
        "app",
        "templ",
        "generate"
      ],
      "changed_paths": ["**/*.templ", "templ.yaml"],
      "input_paths": [
        "**/*.templ",
        "templ.yaml",
        "go.mod",
        "go.sum",
        "compose.yaml",
        "docker-compose.yml",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "authority_paths": [
        "compose.yaml",
        "docker-compose.yml",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "cache": "never",
      "cache_environment": ["DOCKER_HOST", "DM_VERIFICATION_SUBSTRATE"],
      "required_environment": ["DM_VERIFICATION_SUBSTRATE"],
      "authority_environment": ["DM_VERIFICATION_SUBSTRATE"],
      "mutates_repository": true
    },
    {
      "id": "go-focused",
      "tier": "focused",
      "cadences": ["chunk", "revision_batch"],
      "owner": "local",
      "argv": [
        "docker",
        "compose",
        "run",
        "--rm",
        "--no-deps",
        "app",
        "go",
        "test",
        "-tags=dev",
        "-count=1",
        "{packages}"
      ],
      "changed_paths": [
        "**/*.go", "**/*.templ", "templ.yaml",
        "go.mod", "go.sum", "go.work", "go.work.sum"
      ],
      "input_paths": [
        "**/*.go",
        "**/*.templ",
        "templ.yaml",
        "go.mod",
        "go.sum",
        "go.work",
        "go.work.sum",
        "compose.yaml",
        "docker-compose.yml",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "authority_paths": [
        "compose.yaml",
        "docker-compose.yml",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "package_selector": "go_changed",
      "declared_dependents": {},
      "cache": "content",
      "cache_environment": [
        "DOCKER_HOST", "GOFLAGS", "GOWORK", "DM_VERIFICATION_SUBSTRATE"
      ],
      "required_environment": ["DM_VERIFICATION_SUBSTRATE"],
      "authority_environment": ["DM_VERIFICATION_SUBSTRATE"],
      "after": ["templ-generate"]
    },
    {
      "id": "go-full-non-race",
      "tier": "full",
      "cadences": ["execution_level", "merge_candidate", "post_merge"],
      "owner": "local",
      "argv": [
        "docker",
        "compose",
        "run",
        "--rm",
        "--no-deps",
        "app",
        "go",
        "test",
        "-tags=dev",
        "-count=1",
        "./..."
      ],
      "changed_paths": [
        "**/*.go", "**/*.templ", "templ.yaml",
        "go.mod", "go.sum", "go.work", "go.work.sum"
      ],
      "input_paths": [
        "**/*.go",
        "**/*.templ",
        "templ.yaml",
        "go.mod",
        "go.sum",
        "go.work",
        "go.work.sum",
        "compose.yaml",
        "docker-compose.yml",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "authority_paths": [
        "compose.yaml",
        "docker-compose.yml",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "cache": "content",
      "cache_environment": [
        "DOCKER_HOST", "GOFLAGS", "GOWORK", "DM_VERIFICATION_SUBSTRATE"
      ],
      "required_environment": ["DM_VERIFICATION_SUBSTRATE"],
      "authority_environment": ["DM_VERIFICATION_SUBSTRATE"]
    },
    {
      "id": "go-full-race",
      "tier": "race",
      "cadences": ["merge_candidate", "post_merge"],
      "owner": "github",
      "argv": [
        "go",
        "test",
        "-tags=dev",
        "-race",
        "-count=1",
        "-timeout=60m",
        "./..."
      ],
      "changed_paths": [
        "**/*.go", "**/*.templ", "templ.yaml",
        "go.mod", "go.sum", "go.work", "go.work.sum"
      ],
      "input_paths": [
        "**/*.go",
        "**/*.templ",
        "templ.yaml",
        "go.mod",
        "go.sum",
        "go.work",
        "go.work.sum",
        ".github/workflows/**",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "authority_paths": [
        ".github/workflows/**",
        "Dockerfile",
        "Dockerfile.*",
        ".dockerignore",
        ".dm/verification.json"
      ],
      "cache": "content",
      "cache_environment": [
        "GOFLAGS", "GOWORK", "DM_VERIFICATION_SUBSTRATE"
      ],
      "required_environment": ["DM_VERIFICATION_SUBSTRATE"],
      "authority_environment": ["DM_VERIFICATION_SUBSTRATE"]
    }
  ]
}
